{
	"manifest_version": 3,
	"name": "CP Compass Client",
	"description": "OJ代码收集客户端",
	"version": "1.0",
	"permissions": [
		"storage",
		"activeTab"
	],
	"host_permissions": [
		"*://codeforces.com/*/submission/*",
		"*://*.luogu.com.cn/record/*",
		"*://*.luogu.com/record/*",
		"*://*.atcoder.jp/*"
	],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"*://codeforces.com/*/submission/*",
				"*://*.luogu.com.cn/record/*",
				"*://*.luogu.com/record/*",
				"*://*.atcoder.jp/*"
			],
			"js": [
				"content.js"
			]
		}
	],
	"action": {
		"default_popup": "popup.html"
	}
}